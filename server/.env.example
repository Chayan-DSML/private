# Local Postgres. For Cloud SQL, point this at the Auth Proxy or the instance URL.
DATABASE_URL=postgres://tourbhook:tourbhook@127.0.0.1:5432/tourbhook
# Set to true for a direct Cloud SQL connection that requires TLS.
DATABASE_SSL=false

# Long random string. Store the production value in Secret Manager.
JWT_SECRET=replace-with-a-long-random-string

# First admin is created on startup. Change this password before sharing the API.
ADMIN_EMAIL=admin@tourbhook.com
ADMIN_PASSWORD=replace-me

PORT=8787
CORS_ORIGIN=http://127.0.0.1:5173
UPLOAD_DIR=uploads
BCRYPT_ROUNDS=12
