# The API connects through the Cloud SQL Auth Proxy on this machine.
DATABASE_HOST=127.0.0.1
DATABASE_PORT=3306
DATABASE_NAME=tourbhook
DATABASE_USER=tourbhook
DATABASE_PASSWORD=replace-me

# project:region:instance from the Cloud SQL Overview page.
INSTANCE_CONNECTION_NAME=project:region:instance

# Long random string. Store the production value as a secret.
JWT_SECRET=replace-with-a-long-random-string

# First admin is created on startup.
ADMIN_EMAIL=you@example.com
ADMIN_PASSWORD=replace-me

PORT=8787
CORS_ORIGIN=http://127.0.0.1:5173
UPLOAD_DIR=uploads
BCRYPT_ROUNDS=12
